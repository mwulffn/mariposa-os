# Headless 68000 tests for the ROM.
#
# Runs real ROM code under the Musashi 68000 core - no emulator, no display,
# no serial port. Musashi is fetched on demand into ../tools/musashi, which
# is gitignored; it is MIT licensed and is not vendored into this tree.

MUSASHI_REPO ?= https://github.com/kstenerud/Musashi.git
MUSASHI_DIR  ?= ../tools/musashi

ROM ?= ../src/rom/build/kick.rom
SYM ?= ../src/rom/build/kick.sym

# The kernel's vbcc support library. Assembled standalone here rather than
# built with the kernel, so these tests need no C cross compiler.
ASM        ?= vasmm68k_mot
# Kernel assembly that is position independent and so can be assembled
# standalone and loaded by the harness: the maths helpers, and now the
# interrupt primitives and the ISRs.
MODULES     = libsup cpu isr
MODULE_SYMS = $(MODULES:%=$(BUILD)/%.sym)

BUILD  = build
TARGET = $(BUILD)/run-tests

CC ?= cc

# Our code is linted hard. Musashi is third party and is not.
CFLAGS_TEST    = -std=c99 -O1 -g -Wall -Wextra -I. -I$(BUILD) -I$(MUSASHI_DIR)
# M68K_EMULATE_INT_ACK: without it Musashi clears the IRQ line the moment it
# services an interrupt, which makes the line edge-triggered. The Amiga's is
# level-triggered - an interrupt stays asserted until the handler clears its
# INTREQ bit - so the harness supplies an autovector int-ack callback instead.
# Set here rather than by editing m68kconf.h, which lives in the fetched (and
# gitignored) Musashi tree and guards the default with #ifndef for this.
CFLAGS_MUSASHI = -O2 -g -w -I$(MUSASHI_DIR) -DM68K_EMULATE_INT_ACK=1
LDLIBS         = -lm

TEST_SRC = main.c protocol.c harness.c test_format.c test_memory.c test_zorro.c \
           test_vectors.c test_irq.c test_disk.c test_libsup.c test_cpu.c \
           test_kserial.c
TEST_OBJ = $(TEST_SRC:%.c=$(BUILD)/%.o)

MUSASHI_OBJ = $(BUILD)/m68kcpu.o $(BUILD)/m68kdasm.o $(BUILD)/m68kops.o \
              $(BUILD)/softfloat.o

MUSASHI_STAMP = $(MUSASHI_DIR)/m68kops.c

.PHONY: all run clean distclean musashi

all: $(TARGET)

# Exit code is the verdict: 0 all passed, 1 a test failed, 2 harness error.
# FILTER=substring narrows the run to matching "suite.test" names.
FILTER ?=
run: $(TARGET) $(DISK_STAMP) $(MODULE_SYMS)
	@./$(TARGET) --rom $(ROM) --sym $(SYM) --builddir $(BUILD) $(if $(FILTER),--filter $(FILTER),)

$(BUILD):
	mkdir -p $(BUILD)

$(TARGET): $(TEST_OBJ) $(MUSASHI_OBJ) | $(BUILD)
	$(CC) -o $@ $(TEST_OBJ) $(MUSASHI_OBJ) $(LDLIBS)

# Disk images and the layout header the disk tests assert against.
DISK_STAMP = $(BUILD)/disk_layout.h

$(DISK_STAMP): mkdisk.py | $(BUILD)
	@python3 mkdisk.py $(BUILD)

$(BUILD)/test_disk.o: $(DISK_STAMP)

# Assembled at origin zero - the harness loads each one elsewhere and
# biases its symbols to match.
$(BUILD)/%.sym: ../src/kernel/%.s mksym.py | $(BUILD)
	$(ASM) -Fbin -m68000 -no-opt -o $(BUILD)/$*.bin -L $(BUILD)/$*.lst $<
	@python3 mksym.py $(BUILD)/$*.lst $@

# Objects depend on this Makefile so a CFLAGS change actually rebuilds them.
# Without it, flipping -DM68K_EMULATE_INT_ACK left stale Musashi objects in
# place and the flag silently did nothing.
$(TEST_OBJ) $(MUSASHI_OBJ): Makefile

$(BUILD)/%.o: %.c $(MUSASHI_STAMP) | $(BUILD)
	$(CC) $(CFLAGS_TEST) -c -o $@ $<

$(BUILD)/m68kcpu.o: $(MUSASHI_DIR)/m68kcpu.c $(MUSASHI_STAMP) | $(BUILD)
	$(CC) $(CFLAGS_MUSASHI) -c -o $@ $<
$(BUILD)/m68kdasm.o: $(MUSASHI_DIR)/m68kdasm.c $(MUSASHI_STAMP) | $(BUILD)
	$(CC) $(CFLAGS_MUSASHI) -c -o $@ $<
$(BUILD)/m68kops.o: $(MUSASHI_DIR)/m68kops.c $(MUSASHI_STAMP) | $(BUILD)
	$(CC) $(CFLAGS_MUSASHI) -c -o $@ $<
$(BUILD)/softfloat.o: $(MUSASHI_DIR)/softfloat/softfloat.c $(MUSASHI_STAMP) | $(BUILD)
	$(CC) $(CFLAGS_MUSASHI) -c -o $@ $<

musashi: $(MUSASHI_STAMP)

# m68kops.c/h are generated by a tool Musashi ships. Both the clone and the
# generation are one-time; after that this is a no-op.
$(MUSASHI_STAMP): $(MUSASHI_DIR)/m68kmake.c
	cd $(MUSASHI_DIR) && $(CC) -w -o m68kmake m68kmake.c && ./m68kmake

$(MUSASHI_DIR)/m68kmake.c:
	@echo "Fetching Musashi into $(MUSASHI_DIR) (one time, needs network)..."
	@git clone --depth 1 $(MUSASHI_REPO) $(MUSASHI_DIR)

clean:
	rm -rf $(BUILD)

# Also throw away the fetched and generated Musashi tree.
distclean: clean
	rm -rf $(MUSASHI_DIR)
